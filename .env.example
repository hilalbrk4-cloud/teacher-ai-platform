# Copy this file to .env.local and fill in the values you need.
# .env.local is git-ignored and must never be committed.

# Lesson Planner generation provider.
#   mock   - default. No API key required, used by the current UI.
#   openai - calls the OpenAI Responses API server-side. Requires OPENAI_API_KEY.
LESSON_PLAN_PROVIDER=mock

# Required only when LESSON_PLAN_PROVIDER=openai.
# Never commit a real key. This is read server-side only (no NEXT_PUBLIC_ prefix)
# and is never sent to the browser.
OPENAI_API_KEY=
