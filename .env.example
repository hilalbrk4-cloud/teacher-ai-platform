# Copy this file to .env.local and fill in the values you need.
# .env.local is git-ignored and must never be committed.

# Lesson Planner generation provider.
#   mock   - default. No API key required, used by the current UI.
#   openai - calls the OpenAI Responses API server-side. Requires OPENAI_API_KEY.
LESSON_PLAN_PROVIDER=mock

# Required only when LESSON_PLAN_PROVIDER=openai or QUIZ_PROVIDER=openai.
# Never commit a real key. This is read server-side only (no NEXT_PUBLIC_ prefix)
# and is never sent to the browser.
OPENAI_API_KEY=

# Quiz Generator generation provider.
#   mock   - default. No API key required, used by the current UI.
#   openai - calls the OpenAI Responses API server-side. Requires OPENAI_API_KEY.
QUIZ_PROVIDER=mock

# Allows Knowledge Packs with status "draft" / verificationStatus "needsReview"
# to be used for preview purposes in the Quiz Generator flow. Default: false.
# Structurally disabled whenever NODE_ENV=production, regardless of this value —
# draft content must never reach a teacher as if it were verified.
KNOWLEDGE_PACK_DRAFT_PREVIEW=false
